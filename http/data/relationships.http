# Graph · relationships CRUD.
# Se ejecutan con la extensión REST Client de VS Code ("Send Request" sobre cada una) o con httpyac.
# Requires Neo4j: NEO4J_PASSWORD=... uv run prueba-chunking serve (standalone graph server: uv run prueba-chunking-data serve,
# then @graph = http://127.0.0.1:8001). Docs: http://127.0.0.1:8000/data/docs
# Run top to bottom: creates its own "test-*" nodes, the schema's 13 relationships, tries the errors and deletes
# everything (repeatable). Don't run it at the same time as nodes.http: both use the same ids.

@graph = http://127.0.0.1:8000/data

# ── Setup: the nodes the relationships need ─────────────────────────────────────────────────────────

### nodes · create FACULTAD
POST {{graph}}/nodes/FACULTAD
Content-Type: application/json

{"id": "test-eng", "properties": {"name": "Engineering"}}

### nodes · create PROGRAMA (properties of several types, including a list)
POST {{graph}}/nodes/PROGRAMA
Content-Type: application/json

{"id": "test-cs", "properties": {"name": "Computer Science", "credits": 160, "active": true, "campuses": ["Manizales", "Pereira"]}}

### nodes · create ASIGNATURA
POST {{graph}}/nodes/ASIGNATURA
Content-Type: application/json

{"id": "test-db", "properties": {"name": "Databases", "semester": 5}}

### nodes · create PIAA
POST {{graph}}/nodes/PIAA
Content-Type: application/json

{"id": "test-671047", "properties": {"code": "671047", "year": 2024}}

### nodes · create JSON
POST {{graph}}/nodes/JSON
Content-Type: application/json

{"id": "test-json", "properties": {"file": "2024-11-Semana_04-671047-piaa.json"}}

### nodes · create SECCION
POST {{graph}}/nodes/SECCION
Content-Type: application/json

{"id": "test-section", "properties": {"title": "Assessment", "order": 3}}

### nodes · create FRAGMENTOS
POST {{graph}}/nodes/FRAGMENTOS
Content-Type: application/json

{"id": "test-fragment", "properties": {"text": "The final exam is worth 60 %.", "tokens": 9}}

### nodes · create HALLAZGOS
POST {{graph}}/nodes/HALLAZGOS
Content-Type: application/json

{"id": "test-finding", "properties": {"description": "A single exam carries more than 50 % of the grade"}}

### nodes · create ANTIPATRON
POST {{graph}}/nodes/ANTIPATRON
Content-Type: application/json

{"id": "test-antipattern", "properties": {"name": "Concentrated assessment"}}

### nodes · create NORMA
POST {{graph}}/nodes/NORMA
Content-Type: application/json

{"id": "test-rule", "properties": {"name": "Student regulations", "article": "Art. 40"}}

### nodes · create CHAT
POST {{graph}}/nodes/CHAT
Content-Type: application/json

{"id": "test-chat", "properties": {"user": "teacher"}}

### nodes · create CONSULTA
POST {{graph}}/nodes/CONSULTA
Content-Type: application/json

{"id": "test-query", "properties": {"question": "How is the course assessed?"}}

# ── Relationships: create the schema's 13 (201) ─────────────────────────────────────────────────────

### relationships · (FACULTAD)-[:PERTENECE]->(PROGRAMA)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "PERTENECE", "source": {"label": "FACULTAD", "id": "test-eng"}, "target": {"label": "PROGRAMA", "id": "test-cs"}, "properties": {"since": 2001}}

### relationships · (PROGRAMA)-[:HACE_PARTE]->(ASIGNATURA)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "HACE_PARTE", "source": {"label": "PROGRAMA", "id": "test-cs"}, "target": {"label": "ASIGNATURA", "id": "test-db"}}

### relationships · (ASIGNATURA)-[:PERTENECE]->(PIAA)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "PERTENECE", "source": {"label": "ASIGNATURA", "id": "test-db"}, "target": {"label": "PIAA", "id": "test-671047"}}

### relationships · (PIAA)-[:ES]->(JSON)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "ES", "source": {"label": "PIAA", "id": "test-671047"}, "target": {"label": "JSON", "id": "test-json"}}

### relationships · (JSON)-[:TIENE_SECCION]->(SECCION)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "TIENE_SECCION", "source": {"label": "JSON", "id": "test-json"}, "target": {"label": "SECCION", "id": "test-section"}}

### relationships · (SECCION)-[:TIENE_FRAGMENTO]->(FRAGMENTOS)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "TIENE_FRAGMENTO", "source": {"label": "SECCION", "id": "test-section"}, "target": {"label": "FRAGMENTOS", "id": "test-fragment"}}

### relationships · (JSON)-[:TIENE]->(HALLAZGOS)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "TIENE", "source": {"label": "JSON", "id": "test-json"}, "target": {"label": "HALLAZGOS", "id": "test-finding"}}

### relationships · (HALLAZGOS)-[:EN]->(FRAGMENTOS)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "EN", "source": {"label": "HALLAZGOS", "id": "test-finding"}, "target": {"label": "FRAGMENTOS", "id": "test-fragment"}}

### relationships · (HALLAZGOS)-[:DE_TIPO]->(ANTIPATRON)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "DE_TIPO", "source": {"label": "HALLAZGOS", "id": "test-finding"}, "target": {"label": "ANTIPATRON", "id": "test-antipattern"}}

### relationships · (ANTIPATRON)-[:INCUMPLE]->(NORMA)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "INCUMPLE", "source": {"label": "ANTIPATRON", "id": "test-antipattern"}, "target": {"label": "NORMA", "id": "test-rule"}}

### relationships · (CHAT)-[:GENERA]->(CONSULTA)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "GENERA", "source": {"label": "CHAT", "id": "test-chat"}, "target": {"label": "CONSULTA", "id": "test-query"}}

### relationships · (CONSULTA)-[:SOBRE]->(JSON)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "SOBRE", "source": {"label": "CONSULTA", "id": "test-query"}, "target": {"label": "JSON", "id": "test-json"}}

### relationships · (CONSULTA)-[:RESPONDIDA_CON]->(FRAGMENTOS)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "RESPONDIDA_CON", "source": {"label": "CONSULTA", "id": "test-query"}, "target": {"label": "FRAGMENTOS", "id": "test-fragment"}, "properties": {"score": 0.87}}

# ── Relationships: read, list and update ────────────────────────────────────────────────────────────

### relationships · read one
GET {{graph}}/relationships/PERTENECE/FACULTAD/test-eng/PROGRAMA/test-cs

### relationships · list a type (PERTENECE has two pairs: FACULTAD→PROGRAMA and ASIGNATURA→PIAA)
GET {{graph}}/relationships/PERTENECE

### relationships · list with pagination
GET {{graph}}/relationships/PERTENECE?page=2&per_page=1

### relationships · the ones coming into or out of a node (JSON: ES, SOBRE, TIENE_SECCION, TIENE)
GET {{graph}}/nodes/JSON/test-json/relationships

### relationships · PATCH: adds a property, keeps the others
PATCH {{graph}}/relationships/PERTENECE/FACULTAD/test-eng/PROGRAMA/test-cs
Content-Type: application/json

{"properties": {"accredited": true}}

### relationships · PUT: replaces all the properties
PUT {{graph}}/relationships/RESPONDIDA_CON/CONSULTA/test-query/FRAGMENTOS/test-fragment
Content-Type: application/json

{"properties": {"score": 0.91, "model": "local"}}

# ── Relationships: errors ───────────────────────────────────────────────────────────────────────────

### relationships · repeated (409)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "ES", "source": {"label": "PIAA", "id": "test-671047"}, "target": {"label": "JSON", "id": "test-json"}}

### relationships · outside the schema (422, says which pairs PERTENECE allows)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "PERTENECE", "source": {"label": "CHAT", "id": "test-chat"}, "target": {"label": "PROGRAMA", "id": "test-cs"}}

### relationships · reversed from the schema's direction (422)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "ES", "source": {"label": "JSON", "id": "test-json"}, "target": {"label": "PIAA", "id": "test-671047"}}

### relationships · missing end (404)
POST {{graph}}/relationships
Content-Type: application/json

{"type": "HACE_PARTE", "source": {"label": "PROGRAMA", "id": "test-cs"}, "target": {"label": "ASIGNATURA", "id": "does-not-exist"}}

### relationships · none between those nodes (404)
GET {{graph}}/relationships/GENERA/CHAT/test-chat/CONSULTA/does-not-exist

### relationships · type outside the schema (422)
GET {{graph}}/relationships/CONOCE

# ── Cleanup: delete (204; repeating them gives 404) ─────────────────────────────────────────────────

### relationships · delete one (the nodes stay)
DELETE {{graph}}/relationships/PERTENECE/FACULTAD/test-eng/PROGRAMA/test-cs

### relationships · delete it again (404)
DELETE {{graph}}/relationships/PERTENECE/FACULTAD/test-eng/PROGRAMA/test-cs

### nodes · delete JSON: its relationships go with it (DETACH)
DELETE {{graph}}/nodes/JSON/test-json

### nodes · check: PIAA no longer has the ES relationship
GET {{graph}}/nodes/PIAA/test-671047/relationships

### nodes · delete FACULTAD
DELETE {{graph}}/nodes/FACULTAD/test-eng

### nodes · delete PROGRAMA
DELETE {{graph}}/nodes/PROGRAMA/test-cs

### nodes · delete ASIGNATURA
DELETE {{graph}}/nodes/ASIGNATURA/test-db

### nodes · delete PIAA
DELETE {{graph}}/nodes/PIAA/test-671047

### nodes · delete SECCION
DELETE {{graph}}/nodes/SECCION/test-section

### nodes · delete FRAGMENTOS
DELETE {{graph}}/nodes/FRAGMENTOS/test-fragment

### nodes · delete HALLAZGOS
DELETE {{graph}}/nodes/HALLAZGOS/test-finding

### nodes · delete ANTIPATRON
DELETE {{graph}}/nodes/ANTIPATRON/test-antipattern

### nodes · delete NORMA
DELETE {{graph}}/nodes/NORMA/test-rule

### nodes · delete CHAT
DELETE {{graph}}/nodes/CHAT/test-chat

### nodes · delete CONSULTA
DELETE {{graph}}/nodes/CONSULTA/test-query

### nodes · delete one that no longer exists (404)
DELETE {{graph}}/nodes/CONSULTA/test-query

{
  "name": "pias-plataforma",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:up:amd": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.amd.yml up -d",
    "modelos": "bash infra/descargar-modelos.sh",
    "seed": "bash infra/seed.sh",
    "prepare": "lefthook install",
    "env:init": "for f in apps/*/.env.example; do [ -f \"${f%.example}\" ] || cp \"$f\" \"${f%.example}\"; done"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "turbo": "^2.11.4"
  }
}
